# ========================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ========================================
# Este arquivo serve como referência para configurar o sistema.
# Copie este arquivo para .env e preencha com os valores reais.

# === BANCO DE DADOS ===
DATABASE_URL=postgresql://user:password@host:5432/dbname

# === SEGURANÇA ===
SECRET_KEY=sua_chave_secreta_aqui_min_32_caracteres

# === E-MAIL (Flask-Mail) ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@example.com
MAIL_PASSWORD=sua_senha_de_app

# === NOTIFICAÇÕES ===
NOTIFICATION_EMAIL=destinatario@example.com
BASE_URL=http://localhost:5003

# === DEPLOY (Opcional) ===
# PORT=5003
# FLASK_ENV=production
