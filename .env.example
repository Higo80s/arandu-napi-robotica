# ========================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ========================================
# Este arquivo serve como referência para configurar o sistema.
# Copie este arquivo para .env e preencha com os valores reais.

# === BANCO DE DADOS ===
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Pytest (obrigatório para tests/ fora de tests/unit/). Nome do banco deve conter "test".
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/arandu_napi_robotica_test

# === SEGURANÇA ===
SECRET_KEY=sua_chave_secreta_aqui_min_32_caracteres

# === E-MAIL (Flask-Mail) ===
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@example.com
MAIL_PASSWORD=sua_senha_de_app

# === NOTIFICAÇÕES ===
NOTIFICATION_EMAIL=destinatario@example.com
PAGAMENTO_BOLSAS_EMAIL=robotica-ct@utfpr.edu.br
FUNTEF_EMAILS=kamila.camelo@funtefpr.org.br
MAIL_DEFAULT_SENDER=robotica-ct@utfpr.edu.br
BASE_URL=http://localhost:5005
RELATORIO_FINAL_MODELO_URL=https://nuvem.utfpr.edu.br/index.php/s/owE52McFwGeVnI1
RELATORIO_FINAL_REPLY_EMAIL=robotica-ct@utfpr.edu.br
ULTIMO_MES_REPLY_EMAIL=robotica-ct@utfpr.edu.br
ULTIMO_MES_EQUIPE_EMAIL=robotica-ct@utfpr.edu.br
INICIO_BOLSA_REPLY_EMAIL=robotica-ct@utfpr.edu.br
INICIO_BOLSA_EQUIPE_EMAIL=robotica-ct@utfpr.edu.br

# === NUVEM UTFPR (WebDAV / Nextcloud) ===
# URL base WebDAV do usuário (remote.php/dav/files/...)
CLOUD_WEBDAV_URL=https://nuvem.utfpr.edu.br/remote.php/dav/files/SEU_UUID/
CLOUD_USER=robotica-ct
CLOUD_PASSWORD=sua_senha
CLOUD_PAGAMENTOS_FOLDER=05_pagamentos

